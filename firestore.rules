rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasInstitutionalIdentity() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@uwiener[.]edu[.]pe$')
        && request.auth.token.email_verified == true;
    }

    function hasAuthorizedProfile() {
      return hasInstitutionalIdentity()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function isSupervisor() {
      return hasAuthorizedProfile()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isSharedAdvisor() {
      return hasAuthorizedProfile()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'asesor_compartido';
    }

    function canWriteSharedAdvisorRecord(recordId) {
      return isSharedAdvisor()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.asesor is string
        && request.resource.data.advisorKey is string
        && request.resource.data.advisorKey.matches('^[a-z0-9_]+$')
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && get(/databases/$(database)/documents/appConfig/roster).data.advisorMap.get(request.resource.data.advisorKey, '') == request.resource.data.asesor
        && recordId == 'shared_' + request.resource.data.advisorKey + '_' + request.resource.data.date;
    }

    function canWriteOwnRecord(recordId) {
      return hasAuthorizedProfile()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'asesor'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.asesor == get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.asesorNombre
        && request.resource.data.date is string
        && recordId == request.auth.uid + '_' + request.resource.data.date;
    }

    // Profiles are created manually by the project owner. Clients cannot grant themselves a role.
    match /authorizedUsers/{uid} {
      allow get: if hasInstitutionalIdentity() && request.auth.uid == uid;
      allow list: if isSupervisor();
      allow create, update, delete: if false;
    }

    // Advisors can read and modify their own daily records; the supervisor can read all.
    // The supervisor and shared team account can read all daily progress.
    // Individual adviser accounts (if used) can only access their own records.
    match /trackerRecords/{recordId} {
      allow get, list: if isSupervisor()
        || isSharedAdvisor()
        || (hasAuthorizedProfile() && resource.data.ownerUid == request.auth.uid);
      allow create: if canWriteOwnRecord(recordId) || canWriteSharedAdvisorRecord(recordId);
      allow update: if resource.data.ownerUid == request.auth.uid
        && (canWriteOwnRecord(recordId) || canWriteSharedAdvisorRecord(recordId));
      allow delete: if false;
    }

    // One document per month. All authorized users may view team indicators;
    // only the supervisor may create, edit, or delete monthly figures.
    match /monthlyMetrics/{monthId} {
      allow get: if hasAuthorizedProfile();
      allow list: if false;
      allow create, update, delete: if isSupervisor();
    }

    // Legacy metrics path: supervisor only.
    match /appData/{documentId} {
      allow read, write: if isSupervisor();
    }

    // Private operational links: every authorized user may read; only supervisor may manage.
    match /appConfig/{documentId} {
      allow get: if hasAuthorizedProfile();
      allow list: if false;
      allow create, update, delete: if isSupervisor();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
